# ---- 本地个人文件（工具链、临时笔记等），不提交 GitHub ----
ignore/

# ---- 介绍视频的工程与成品（工具、录屏原始帧、音频、成片都很大）----
video/

# ---- npm 本地缓存（沙箱内安装时使用）----
.npm-cache/

# ---- 测试用可执行文件与桌面打包产物 ----
# 我们自己测试用的免安装 exe 与安装包都不进仓库；正式发布走 GitHub Releases。
# 注意不要写成全局 *.exe，否则会误伤 ignore/ 之外将来可能需要的脚本。
release/
app/release/
app/src-tauri/target/
# 本地引擎二进制（103MB）不进仓库；打包前把 Stockfish 放到该目录并命名带目标三元组后缀
app/src-tauri/binaries/

# ---- Node / 前端工程 ----
node_modules/
dist/
build/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---- 环境与密钥 ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db

# ---- 部署产物 ----
.coverage
htmlcov/
